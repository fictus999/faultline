# Copy to .env (gitignored). Compose loads it for every Faultline container.

FAULTLINE_WEBHOOK_SECRET=replace-with-a-long-random-string

# Sinks: log and webhook work offline. Add sns and/or cloudwatch once AWS is set up.
FAULTLINE_SINKS=log,webhook

# Point the webhook at n8n instead of the built-in receiver (make n8n does this for one run):
# FAULTLINE_WEBHOOK_URL=http://n8n:5678/webhook/faultline

# AWS (least-privilege IAM user for the laptop demo; CI uses GitHub OIDC instead)
# FAULTLINE_SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:faultline-alerts
# FAULTLINE_CW_LOG_GROUP=/faultline/demo/alerts
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
